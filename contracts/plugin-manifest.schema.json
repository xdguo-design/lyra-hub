{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/contracts/plugin-manifest-v1.schema.json",
  "title": "Lyra Hub Plugin Manifest v1",
  "type": "object",
  "required": ["schemaVersion", "id", "name", "version", "type", "targetApplications", "contributes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,95}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1 },
    "type": { "const": "plugin" },
    "description": { "type": "string" },
    "targetApplications": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "consumes": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "widgets": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "navigation": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/contribution" } },
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "component"],
            "properties": {
              "target": { "type": "string", "minLength": 1 },
              "component": { "type": "string", "minLength": 1 },
              "order": { "type": "integer" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "contribution": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "component": { "type": "string" },
        "path": { "type": "string" },
        "order": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}