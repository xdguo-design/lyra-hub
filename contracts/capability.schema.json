{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/contracts/capability-v1.schema.json",
  "title": "Lyra Capability Definition v1",
  "type": "object",
  "required": ["schemaVersion", "name", "source", "mutation", "permissions"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "source": { "enum": ["gateway", "agent-os", "hub", "application"] },
    "mutation": { "type": "boolean" },
    "description": { "type": "string" },
    "permissions": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "inputSchemaRef": { "type": "string" },
    "outputSchemaRef": { "type": "string" },
    "deprecated": { "type": "boolean", "default": false }
  },
  "additionalProperties": false
}