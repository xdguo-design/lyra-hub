{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyra.local/contracts/permission-v1.schema.json",
  "title": "Lyra Permission Definition v1",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "scope", "risk"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "scope": { "enum": ["platform", "application", "tenant"] },
    "risk": { "enum": ["read", "write", "execute", "admin"] },
    "applicationId": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}