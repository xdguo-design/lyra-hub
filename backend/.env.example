LYRA_HUB_DATABASE_URL=sqlite:///./lyra-hub.db

# Sibling platform services. Defaults match the local launchers in lyra-gateway and lyra-agents.
LYRA_GATEWAY_URL=http://127.0.0.1:8765
LYRA_GATEWAY_TOKEN=

LYRA_AGENT_OS_URL=http://127.0.0.1:8770
LYRA_AGENT_OS_TOKEN=
LYRA_AGENT_RUNTIME_TOKEN=

LYRA_PRINT_URL=http://127.0.0.1:8080
LYRA_PRINT_API_KEY=

LYRA_NARRATIVE_URL=http://127.0.0.1:8001

LYRA_PLATFORM_TIMEOUT_SECONDS=5


# Server-to-server application authentication.
# Keep these secrets out of application manifests and browser code.
# Example: {"lyra-narrative":"replace-me","lyra-print":"replace-me"}
LYRA_APP_TOKENS_JSON={}


# HMAC secrets for event webhook subscriptions. Database records store only secret_ref.
# Example: {"narrative-events":"replace-me","print-events":"replace-me"}
LYRA_WEBHOOK_SECRETS_JSON={}


# Event webhook worker.
LYRA_EVENT_WORKER_POLL_SECONDS=5
LYRA_EVENT_WORKER_BATCH_SIZE=50
LYRA_EVENT_WORKER_LEASE_SECONDS=300


# Explicit cross-application file handoff directory. Leave unset to disable file.read.
LYRA_SHARED_FILES_ROOT=
LYRA_SHARED_FILE_MAX_BYTES=1048576


# Hub-to-application provider credentials. Keys are application ids.
# Example: {"lyra-print":"replace-with-print-operator-key"}
LYRA_PROVIDER_TOKENS_JSON={}
# Optional deployment-specific provider URL overrides.
# Example: {"lyra-print":"https://print.internal.example"}
LYRA_PROVIDER_BASE_URLS_JSON={}
